{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "main",
    "namedInputs": {
      "default": ["{projectRoot}/**/*", "sharedGlobals"],
      "production": ["default", "!{projectRoot}/**/*.spec.ts", "!{projectRoot}/**/*.e2e-spec.ts"],
      "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json"]
    },
    "targetDefaults": {
      "build": {
        "dependsOn": ["^build"],
        "inputs": ["production", "^production"],
        "cache": true
      },
      "test": {
        "inputs": ["default", "^production"],
        "cache": true
      },
      "lint": {
        "inputs": ["default"],
        "cache": true
      }
    },
    "plugins": [
      {
        "plugin": "@nx/nest",
        "options": {}
      }
    ]
  }
  