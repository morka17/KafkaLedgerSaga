{
  "name": "order-service",
  "version": "1.0.0",
  "private": true,
  "description": "Owns the order aggregate, persists order domain events, and reacts to saga commands for create/confirm/cancel order transitions.",
  "main": "src/main.ts",
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "start": "node ../../dist/apps/order-service/main.js",
    "start:dev": "nodemon --exec ts-node -r tsconfig-paths/register src/main.ts",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@saganova/common": "workspace:*",
    "@saganova/database": "workspace:*",
    "@saganova/event-contracts": "workspace:*",
    "@saganova/event-sourcing-core": "workspace:*",
    "@saganova/kafka-client": "workspace:*",
    "@saganova/observability": "workspace:*",
    "@nestjs/common": "^10.3.7",
    "@nestjs/core": "^10.3.7",
    "@nestjs/microservices": "^10.3.7",
    "@nestjs/platform-express": "^10.3.7",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
