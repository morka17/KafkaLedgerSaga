{
    "name": "api-gateway",
    "version": "1.0.0",
    "private": true,
    "description": "Public-facing REST/GraphQL entrypoint. Validates requests, issues JWTs, and forwards commands into the Kafka backbone. Holds no business/domain logic of its own.",
    "main": "src/main.ts",
    "scripts": {
      "build": "tsc -p tsconfig.app.json",
      "start": "node ../../dist/apps/api-gateway/main.js",
      "start:dev": "nodemon --exec ts-node -r tsconfig-paths/register src/main.ts",
      "lint": "eslint \"src/**/*.ts\"",
      "test": "jest --config ../../jest.preset.js --rootDir ."
    },
    "dependencies": {
      "@saganova/common": "workspace:*",
      "@saganova/kafka-client": "workspace:*",
      "@saganova/event-contracts": "workspace:*",
      "@saganova/observability": "workspace:*",
      "@nestjs/common": "^10.3.7",
      "@nestjs/core": "^10.3.7",
      "@nestjs/platform-express": "^10.3.7",
      "@nestjs/jwt": "^10.2.0",
      "@nestjs/passport": "^10.0.3",
      "@nestjs/graphql": "^12.2.0",
      "@nestjs/apollo": "^12.2.0",
      "@apollo/server": "^4.10.4",
      "@nestjs/axios": "^3.0.2",
      "axios": "^1.7.2",
      "passport": "^0.7.0",
      "passport-jwt": "^4.0.1",
      "helmet": "^7.1.0",
      "class-validator": "^0.14.1",
      "class-transformer": "^0.5.1",
      "rxjs": "^7.8.1",
      "reflect-metadata": "^0.2.2"
    },
    "devDependencies": {
      "@types/passport-jwt": "^4.0.1",
      "@types/express": "^4.17.21",
      "nodemon": "^3.1.0",
      "ts-node": "^10.9.2",
      "tsconfig-paths": "^4.2.0"
    }
  }
  