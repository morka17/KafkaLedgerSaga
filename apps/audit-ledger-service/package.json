{
  "name": "audit-ledger-service",
  "version": "1.0.0",
  "private": true,
  "description": "Wildcard consumer of every domain-event topic. Writes an immutable, append-only audit record for compliance, replay, and debugging. Never publishes back into the system.",
  "main": "src/main.ts",
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "start": "node ../../dist/apps/audit-ledger-service/main.js",
    "start:dev": "nodemon --exec ts-node -r tsconfig-paths/register src/main.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/infrastructure/postgres/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/infrastructure/postgres/data-source.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --config ../../jest.preset.js --rootDir ."
  },
  "dependencies": {
    "@saganova/common": "workspace:*",
    "@saganova/kafka-client": "workspace:*",
    "@saganova/event-contracts": "workspace:*",
    "@saganova/database": "workspace:*",
    "@saganova/observability": "workspace:*",
    "@nestjs/common": "^10.3.7",
    "@nestjs/core": "^10.3.7",
    "@nestjs/platform-express": "^10.3.7",
    "@nestjs/microservices": "^10.3.7",
    "@nestjs/typeorm": "^10.0.2",
    "typeorm": "^0.3.20",
    "pg": "^8.11.5",
    "kafkajs": "^2.2.4",
    "rxjs": "^7.8.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
