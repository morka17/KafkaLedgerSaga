{
  "name": "notification-service",
  "version": "1.0.0",
  "private": true,
  "description": "Stateless consumer of OrderConfirmed/OrderCancelled/PaymentDeclined. Sends email/SMS. Decoupled from the saga's critical path — a failure here never blocks or compensates the transaction.",
  "main": "src/main.ts",
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "start": "node ../../dist/apps/notification-service/main.js",
    "start:dev": "nodemon --exec ts-node -r tsconfig-paths/register src/main.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --config ../../jest.preset.js --rootDir ."
  },
  "dependencies": {
    "@saganova/common": "workspace:*",
    "@saganova/kafka-client": "workspace:*",
    "@saganova/event-contracts": "workspace:*",
    "@saganova/observability": "workspace:*",
    "@nestjs/common": "^10.3.7",
    "@nestjs/core": "^10.3.7",
    "@nestjs/platform-express": "^10.3.7",
    "@nestjs/microservices": "^10.3.7",
    "kafkajs": "^2.2.4",
    "@sendgrid/mail": "^8.1.3",
    "twilio": "^5.1.1",
    "rxjs": "^7.8.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
