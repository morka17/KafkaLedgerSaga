{
  "name": "notification-service",
  "version": "1.0.0",
  "private": true,
  "description": "Consumes business outcome events and emits customer-facing email/SMS notifications outside the saga critical path.",
  "main": "src/main.ts",
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "start": "node ../../dist/apps/notification-service/main.js",
    "start:dev": "nodemon --exec ts-node -r tsconfig-paths/register src/main.ts",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@saganova/common": "workspace:*",
    "@saganova/event-contracts": "workspace:*",
    "@saganova/kafka-client": "workspace:*",
    "@saganova/observability": "workspace:*",
    "@nestjs/common": "^10.3.7",
    "@nestjs/core": "^10.3.7",
    "@nestjs/microservices": "^10.3.7",
    "@nestjs/platform-express": "^10.3.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
